;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[3d_physics]

layer_3="furniture"

[application]

config/name="scape-room"
run/main_scene="res://scenes/test/house_test_level.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
Inventory="*uid://ccld7x56jgru3"
PuzzleManager="*uid://de5s3k8bnol1p"
GameManager="*uid://dap4ofrwgt1ui"
PuzzleUI="*uid://df6ia87wdfqgw"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg")

