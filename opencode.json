{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "godot-mcp-toolkit": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@npgamedev/godot-mcp-server@1.1.2"],
        "cwd": ".",
        "environment": {
          "GODOT_MCP_CONFIG_VERSION": "1",
          "npm_config_prefer_offline": "true"
        }
      }
    }
  }
}
